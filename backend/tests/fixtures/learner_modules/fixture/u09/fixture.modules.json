    {
      "id": "fixture.modules.challenge",
      "type": "challenge",
      "prompt": "Read numbers on one line, and print their total. Write total(numbers) in scores.py; main.py uses it.",
      "starter": "import scores\n\nnumbers = [int(n) for n in input().split()]\nprint(scores.total(numbers))\n",
      "hints": [
        "Open scores.py.",
        "Define total with one parameter.",
        "Add the numbers up and return the sum."
      ],
      "error_hints": [
        {
          "tags": [
            "NameError"
          ],
          "text": "Check the spelling of each name, in main.py and in scores.py."
        },
        {
          "tags": [
            "fixture.modules.case.small",
            "fixture.modules.case.other"
          ],
          "text": "Return the sum of every number in the list."
        }
      ],
      "similar_example": {
        "code": "print(1 + 2)",
        "note": "Test data."
      },
      "other_ways": [
        {
          "code": "import scores\n\nprint(scores.total(int(n) for n in input().split()))",
          "note": "Test data."
        }
      ],
      "input_labels": [],
      "check": {
        "cases": [
          {
            "id": "small",
            "description": "two numbers",
            "inputs": [
              "3 4"
            ],
            "expected": "7"
          },
          {
            "id": "other",
