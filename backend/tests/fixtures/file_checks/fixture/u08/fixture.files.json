    },
    {
      "id": "fixture.files.example",
      "type": "example",
      "code": "with open(\"note.txt\") as f:\n    print(f.read())",
      "output": "hello from the file",
      "note": "Test data.",
      "inputs": [],
      "files": {
        "note.txt": "hello from the file"
      }
    },
    {
      "id": "fixture.files.predict",
      "type": "predict",
      "question": "Test data?",
      "options": [
        "Yes",
        "No"
      ],
