    {
      "id": "fixture.tests.challenge",
      "type": "challenge",
      "prompt": "Write assert lines for score(guess, secret): 10 if exact, 5 within 2, otherwise 0.",
      "starter": "# Write assert lines\n",
      "hints": [
        "One.",
        "Two.",
        "Three."
      ],
      "error_hints": [
        {
          "tags": [
            "fixture.tests.case.correct"
          ],
          "text": "Check what your assert expects from correct code."
        },
        {
          "tags": [
            "fixture.tests.case.always-ten"
          ],
          "text": "Try a guess that is not exact."
        },
        {
          "tags": [
            "fixture.tests.case.far"
          ],
          "text": "Try a guess that is far away."
        }
      ],
      "similar_example": {
        "code": "print(2)",
        "note": "Test data."
      },
      "other_ways": [
        {
          "code": "results = [score(7, 7), score(9, 7), score(20, 7)]\nassert results == [10, 5, 0]",
          "note": "Test data."
        }
      ],
      "input_labels": [],
      "check": {
        "cases": [
          {
            "id": "correct",
            "description": "the correct scorer",
            "reference": "def score(guess, secret):\n    if guess == secret:\n        return 10\n    if abs(guess - secret) <= 2:\n        return 5\n    return 0\n",
            "test_should": "pass"
          },
          {
            "id": "always-ten",
            "description": "a scorer with a bug",
            "reference": "def score(guess, secret):\n    return 10\n",
            "test_should": "fail"
          },
          {
            "id": "edge",
            "description": "another scorer with a bug",
            "reference": "def score(guess, secret):\n    if guess == secret:\n        return 10\n    if abs(guess - secret) < 2:\n        return 5\n    return 0\n",
            "test_should": "fail"
          },
          {
            "id": "far",
            "description": "a scorer you cannot see",
            "visibility": "hidden",
            "reference": "def score(guess, secret):\n    return 10 if guess == secret else 5\n",
            "test_should": "fail"
          }
        ],
        "time_limit_ms": 3000
      },
      "validator": {
        "id": "browser-tests",
        "version": 1
      },
      "version": 1
    }
