        "concept": "Loops · while",
        "description": "Let the player keep guessing the secret number until they get it right.",
        "badge": "Patient guesser"
       },
       {
        "id": "py.loop-termination",
        "title": "Three tries",
        "concept": "Loops · stopping on time",
        "description": "Give the player three tries, and make sure the loop always ends.",
